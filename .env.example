# Supabase — public client config (safe to expose in the browser).
# Wired up starting Phase 2. Copy this file to .env.local and fill in real values.
# Get them from your Supabase project: Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# WARNING: never put the service_role / secret key in a NEXT_PUBLIC_* var.
# It bypasses Row-Level Security and would leak every user's data to the client.
#
# The application runtime no longer needs the service_role key: account deletion now goes
# through the scoped `delete_own_account()` RPC (migration 012), not auth.admin.deleteUser.
# Only the integration/e2e tests use a service-role client, and they read it from
# `supabase status` at runtime — it is never committed and never shipped to the browser.
